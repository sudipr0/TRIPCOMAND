# TrailComand marketing website — environment configuration
#
# Copy to `.env.local` for local work, and set the same variables in your hosting
# provider for production. Every variable here is PUBLIC: it is inlined into the
# browser bundle at build time. Never put a secret, API key or private token in
# this file. Nothing here is required to view the site locally.

# Canonical origin of the public site, e.g. https://trailcomand.com
# Leave empty until the production domain is confirmed. While empty:
#   - no <link rel="canonical"> tags are emitted
#   - no absolute og:url / og:image tags are emitted
#   - /sitemap.xml is served empty and robots.txt omits the Sitemap line
# Set this at BUILD time for it to take effect (NEXT_PUBLIC_* is build-time).
NEXT_PUBLIC_SITE_URL=

# Destination of every "Login" link. Defaults to https://app.trailcomand.com/login
# Override for staging, e.g. https://staging-app.trailcomand.com/login
NEXT_PUBLIC_LOGIN_URL=

# Contact form delivery. Prefer a Formspree endpoint:
#   NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
# This is a public form id, not a token. While it is empty, the contact form
# validates normally and then opens the visitor's own email app (mailto) instead
# of pretending the enquiry was sent.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Address used by the mailto fallback, the footer link and the privacy note.
# Defaults to hello@trailcomand.com
NEXT_PUBLIC_CONTACT_EMAIL=
